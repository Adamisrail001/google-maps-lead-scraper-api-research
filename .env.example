# Copy this file to .env and fill in your own real values.
# .env must never be committed and must never contain real credentials in
# this file (.env.example) - placeholders only.
#
# Pattern file — one block per provider you add to the benchmark. Delete
# blocks for providers you're not testing; add new ones as needed.

# --- {Provider 1} ---
PROVIDER1_API_KEY=

# --- {Provider 2} ---
PROVIDER2_API_KEY=

# --- {Provider 3} ---
# Example: HTTP Basic Auth pair instead of a single key.
PROVIDER3_LOGIN=
PROVIDER3_PASSWORD=

# --- Optional run-mode safety flags (read by benchmark scripts) ---
# Each provider's benchmark script should refuse to make paid/live API
# calls unless explicitly confirmed. Convention used throughout this
# template:
#   CONFIRM_PAID_RUN=yes    python scripts/<provider>/benchmark.py run
#   CONFIRM_SMOKE_RUN=yes   python scripts/<provider>/benchmark.py smoke
